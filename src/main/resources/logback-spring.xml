<?xml version="1.0" encoding="UTF-8"?>
<!--
  Adds requestId/user (set by RequestLoggingFilter via MDC) to every log
  line automatically - no change needed to GlobalExceptionHandler or any
  other existing log.error/log.warn call site. Otherwise identical to
  Spring Boot's own default console pattern.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%clr(%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}){faint} %clr(%5p) %clr([%X{requestId}/%X{user}]){cyan} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n%wEx</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
